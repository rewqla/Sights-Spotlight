### Create a new country
POST  {{baseUrl}}/api/countries
x-api-key: ab813b98016e4cf181cb20b88f756f28
Content-Type: application/json
Authorization:Bearer {{authToken}}

{
  "name": "polanduis3",
  "description": "Not bad as mad",
  "mainImageURL": "23",
  "secondaryImageURL": "2223"
}

### Update the country
Put  {{baseUrl}}/api/countries/182
Content-Type: application/json
Authorization:Bearer {{authToken}}

{
  "id":20,
  "name": "Italyyy",
  "description": "Not bad as mad2",
  "mainImageURL": "23",
  "secondaryImageURL": "2223"
}

### Update the country
DELETE  {{baseUrl}}/api/countries/20
Content-Type: application/json
Authorization:Bearer {{authToken}}